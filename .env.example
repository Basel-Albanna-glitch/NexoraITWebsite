# Copy to .env.local and fill in. Without SMTP settings, contact messages
# are only printed to the server console (handy in development).

# Where contact-form messages are delivered
CONTACT_TO=nexoraitt@gmail.com

# SMTP account used to send them (Gmail: use an App Password; Outlook/M365, Zoho etc. also work)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nexoraitt@gmail.com
SMTP_PASS=your-app-password
# Optional "From" header; defaults to SMTP_USER
SMTP_FROM="NexoraIT Website <nexoraitt@gmail.com>"

# Public URL of the site (used for social-share previews)
NEXT_PUBLIC_SITE_URL=https://nexorait.com

# Dashboard (/admin): the password you sign in with. Use something long and unique.
ADMIN_PASSWORD=change-me
# Optional: separate secret for signing login sessions (changing it signs everyone out)
# ADMIN_SECRET=
